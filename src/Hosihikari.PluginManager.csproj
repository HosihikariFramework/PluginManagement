<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari.PluginManagement</RootNamespace>
    <AssemblyName>Hosihikari.PluginManager</AssemblyName>
    <!-- 被原生宿主加载的类库要这个：没有它就不产出 runtimeconfig.json / deps.json，宿主无从初始化运行时。 -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hocon.Extensions.Configuration" Version="2.0.4" />
    <PackageReference Include="McMaster.NETCore.Plugins" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <!-- 兜底的落地端：原生宿主接不上 .NET 的 logger factory，没有它插件的日志会写进虚空。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

  <!-- 契约来自另一个仓，两种拿法二选一：并列摆放时直接编在一起（改契约不用重新打包），
       否则走包 —— 单独 clone 与 CI 走这条，插件作者也只有这一条。 -->
  <ItemGroup Condition="Exists('../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj')">
    <ProjectReference Include="../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj')">
    <PackageReference Include="Hosihikari.Abstractions" Version="[0.4.0]" />
  </ItemGroup>

</Project>
