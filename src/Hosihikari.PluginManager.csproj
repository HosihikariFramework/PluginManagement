<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari.PluginManagement</RootNamespace>
    <AssemblyName>Hosihikari.PluginManager</AssemblyName>
    <!-- 被原生宿主加载的类库要这个：没有它就不产出 runtimeconfig.json / deps.json，宿主无从初始化运行时。 -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 日志出口要用函数指针调回父级。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 日志是唯一的线索（ADR-0009）；异步与迭代器的栈是编译器生成的，不去谜读不懂。 -->
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />
    <PackageReference Include="Hocon.Extensions.Configuration" Version="2.0.4" />
    <!-- 本机库的 RID 优先解析需要 fork；并列 checkout 时直接编，否则走 fork 的包。 -->
    <ProjectReference Include="../../Hosihikari.McMaster.NETCore.Plugins/src/Plugins/McMaster.NETCore.Plugins.csproj"
                      Condition="Exists('../../Hosihikari.McMaster.NETCore.Plugins/src/Plugins/McMaster.NETCore.Plugins.csproj')" />
    <PackageReference Include="Hosihikari.McMaster.NETCore.Plugins" Version="2.1.0-hosihikari.1"
                      Condition="!Exists('../../Hosihikari.McMaster.NETCore.Plugins/src/Plugins/McMaster.NETCore.Plugins.csproj')" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <!-- 兜底的落地端：原生宿主接不上 .NET 的 logger factory，没有它插件的日志会写进虚空。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hosihikari.PluginManager.Host" />
    <!-- 清单的 entry 出界判断在载入期与打包期共用一份。 -->
    <InternalsVisibleTo Include="Hosihikari.Plugin.Pack" />
  </ItemGroup>

  <!-- 契约来自另一个仓，两种拿法二选一：并列摆放时直接编在一起（改契约不用重新打包），
       否则走包 —— 单独 clone 与 CI 走这条，插件作者也只有这一条。 -->
  <ItemGroup Condition="Exists('../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj')">
    <ProjectReference Include="../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj')">
    <PackageReference Include="Hosihikari.Abstractions" Version="[0.7.0]" />
  </ItemGroup>

</Project>
