<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari.Testing</RootNamespace>
    <AssemblyName>Hosihikari.Testing</AssemblyName>
    <PackageId>Hosihikari.Testing</PackageId>
    <Version>1.0.0</Version>
    <Authors>HosihikariFramework</Authors>
    <Description>Test host and in-memory host services for Hosihikari plugins.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariFramework/PluginManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>hosihikari;minecraft;bedrock;plugin;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <ProjectReference Include="../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <PackageReference Include="Hosihikari.Plugin.Abstractions" Version="[1.1.0]" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../src/Hosihikari.PluginManager.csproj')">
    <ProjectReference Include="../../src/Hosihikari.PluginManager.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../src/Hosihikari.PluginManager.csproj')">
    <PackageReference Include="Hosihikari.PluginManager" Version="[1.1.0]" />
  </ItemGroup>

</Project>
