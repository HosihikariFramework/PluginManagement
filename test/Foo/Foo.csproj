<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Foo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Bindings.Stub/Bindings.Stub.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Private=false / ExcludeAssets=runtime：契约与载体绑定都驻留共享层，插件不得自带副本
       （ADR-0004 / ADR-0019）。两种拿法都要带上这两条。 -->
  <ItemGroup Condition="Exists('../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <ProjectReference Include="../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <PackageReference Include="Hosihikari.Plugin.Abstractions" Version="[1.0.0]" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- 普通依赖：两个插件都引用它，它不是契约、不在共享层。 -->
    <ProjectReference Include="../Lib/Lib.csproj" />
  </ItemGroup>

</Project>
