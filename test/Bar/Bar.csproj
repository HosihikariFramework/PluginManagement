<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bar</AssemblyName>
  </PropertyGroup>

  <ItemGroup Condition="Exists('../../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj')">
    <ProjectReference Include="../../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../../Hosihikari.Abstractions/src/Hosihikari.Abstractions.csproj')">
    <PackageReference Include="Hosihikari.Abstractions" Version="[0.6.0]" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- 普通依赖：两个插件都引用它，它不是契约、不在共享层。 -->
    <ProjectReference Include="../Lib/Lib.csproj" />
  </ItemGroup>

</Project>
