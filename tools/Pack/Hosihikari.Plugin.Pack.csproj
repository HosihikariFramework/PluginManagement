<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hosihikari.Plugin.Pack</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hosihikari.PluginManager.csproj" />
    <!-- 只读元数据地看入口声明的唯一现实办法：LoadFrom 会把程序集留在默认 ALC 里。 -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.13" />
  </ItemGroup>

</Project>
